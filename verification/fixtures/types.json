{
  "formatVersion": 1,
  "specVersion": "0.2.0",
  "id": "types",
  "why": "The canonical axis records what the engine STORES, not what a consumer wants. sqlite is mapped by AFFINITY because its declared type is a hint and nothing is enforced; Postgres is mapped by udt_name because the type is real. A type the tables do not describe refuses — it never becomes \"other\", and citext never becomes text.",
  "cases": [
    {
      "engine": "sqlite",
      "raw": "INTEGER",
      "expects": "integer"
    },
    {
      "engine": "sqlite",
      "raw": "BIGINT",
      "expects": "integer"
    },
    {
      "engine": "sqlite",
      "raw": "POINT",
      "expects": "integer"
    },
    {
      "engine": "sqlite",
      "raw": "VARCHAR(40)",
      "expects": "text"
    },
    {
      "engine": "sqlite",
      "raw": "TEXT",
      "expects": "text"
    },
    {
      "engine": "sqlite",
      "raw": "CLOB",
      "expects": "text"
    },
    {
      "engine": "sqlite",
      "raw": "REAL",
      "expects": "real"
    },
    {
      "engine": "sqlite",
      "raw": "DOUBLE PRECISION",
      "expects": "real"
    },
    {
      "engine": "sqlite",
      "raw": "BLOB",
      "expects": "binary"
    },
    {
      "engine": "sqlite",
      "raw": "",
      "expects": "binary"
    },
    {
      "engine": "sqlite",
      "raw": "BOOLEAN",
      "expects": "numeric"
    },
    {
