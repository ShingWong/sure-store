      "engine": "postgres",
      "raw": "text",
      "expects": "text"
    },
    {
      "engine": "postgres",
      "raw": "varchar",
      "expects": "text"
    },
    {
      "engine": "postgres",
      "raw": "bpchar",
      "expects": "text"
    },
    {
      "engine": "postgres",
      "raw": "citext",
      "expects": "citext"
    },
    {
      "engine": "postgres",
