  "refuses": [
    {
      "engine": "postgres",
      "raw": "inet",
      "why": "measured and genuinely unmapped — a consumer must decide, so the mapper refuses rather than inventing a category"
    },
    {
      "engine": "postgres",
      "raw": "interval",
      "why": "unmapped; time intervals are not the same axis as timestamps"
    },
    {
      "engine": "postgres",
      "raw": "tsvector",
      "why": "a search artefact, not a value type a consumer should see"
    }
  ],
  "notes": {
    "citext": "Deliberate divergence from sure-factor's own habit: CITEXT is NOT text here. Collapsing it would drop the case-insensitivity the type was chosen for, which is a semantic property, not a formatting one.",
    "sqliteAffinity": "BOOLEAN and DATETIME map to numeric, not boolean and timestamp. That is not a limitation of the mapper: SQLite enforces nothing, so claiming a boolean would assert a constraint the engine does not hold.",
    "valuesNotAffinity": "Measured: a '1' in a BOOLEAN column reports typeof integer, and a date string in a DATETIME column stays text. Both are NUMERIC affinity; neither is storage enforcement."
  }
}
