  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "ShingWong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShingWong/sure-store.git"
  },
  "type": "module",
  "main": "./impl/ts/index.ts",
  "exports": {
    ".": "./impl/ts/index.ts",
